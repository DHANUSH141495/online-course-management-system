{
  "name": "coursify-course-management",
  "version": "1.0.0",
  "description": "Full-Stack Online Course Management & Certification Platform",
  "main": "server/src/server.js",
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently --kill-others \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "node server/src/server.js",
    "test": "node server/test_all_endpoints.js",
    "seed": "node server/src/config/db.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "course-management",
    "full-stack",
    "react",
    "express",
    "sqlite",
    "education"
  ],
  "author": "Dhanush",
  "license": "MIT"
}
